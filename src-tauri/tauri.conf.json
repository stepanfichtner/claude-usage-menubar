{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Claude Usage",
  "identifier": "com.stepanfichtner.claude-usage-menubar",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "popover",
        "url": "index.html",
        "title": "Claude Usage",
        "width": 320,
        "height": 480,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "skipTaskbar": true,
        "visible": false,
        "shadow": true
      },
      {
        "label": "settings",
        "url": "settings.html",
        "title": "Claude Usage \u2014 Settings",
        "width": 660,
        "height": 600,
        "resizable": true,
        "visible": false,
        "minWidth": 560,
        "minHeight": 420
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; base-uri 'self'; form-action 'none'; object-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "app"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libayatana-appindicator3-1"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY4RTMyNTcxNThDNkM0Q0IKUldUTHhNWlljU1hqK0MrSnVEeVl2ODd3SkVpQm9hVWgzMk1OeUlaU2s4Z0F3VVBlV0dyaG8wTksK",
      "endpoints": [
        "https://github.com/stepanfichtner/claude-usage-menubar/releases/latest/download/latest.json"
      ]
    }
  }
}
